# Optional user service. Copy and configure manually; see docs/systemd.md.
[Unit]
Description=DeepSeek V4.1 Flash TensorFold on two Sparks
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=simple
# Replace this with the absolute checkout path (quote paths containing spaces).
WorkingDirectory=/absolute/path/to/recipe
Environment=FOREGROUND=1 PREPARE=0
ExecStart=/usr/bin/bash ./start.sh
ExecStop=/usr/bin/bash ./stop.sh
Restart=on-failure
RestartSec=60s
TimeoutStopSec=120s

[Install]
WantedBy=default.target
